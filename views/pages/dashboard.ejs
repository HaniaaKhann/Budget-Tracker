<%- include('../partials/app-header') %>
<% const formatMoney = (n) => "$" + Number(n).toLocaleString("en-HK"); %>

<div class="d-flex app-layout">
    <%- include('../partials/sidebar') %>

        <div class="app-content">
            <div class="container-fluid">
                <% if (flash==='added'){ %>
                    <div class="alert alert-success alert-dismissible fade show">Transaction added.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <%}%>
                <% if (flash==='updated'){ %>
                    <div class="alert alert-success alert-dismissible fade show">Transaction updated.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <%}%>
                <% if (flash==='deleted'){ %>
                    <div class="alert alert-success alert-dismissible fade show">Transaction deleted.
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <%}%>
                <% if (flash==='error'){ %>
                    <div class="alert alert-danger alert-dismissible fade show">Error!
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                <%}%>

                <div class="card shadow-sm mb-4">
                    <div class="card-body">
                        <h3 class="card-title">
                            Hello, <%= user.name || user.email %>
                        </h3>
                        <p class="text-muted">Welcome back to your dashboard.</p>
                    </div>
                </div>


                <!-- Weather Section -->
                <div class="weather-section">
                <% if (weather) { %>
                    <div class="weather-card">
                        <div class="weather-header">
                            <div>
                                <p class="city"><%= weather.city %></p>
                                <p class="condition"><%= weather.condition %></p>
                            </div>
                            <img src="https://openweathermap.org/img/wn/<%= weather.icon %>@2x.png" alt="weather icon"
                                class="weather-icon">
                        </div>
                        <div class="weather-body">
                            <p class="temp"><%= weather.temp %>°C</p>
                        </div>
                    </div>
                <% } else { %>
                    <div class="weather-card unavailable">
                        <div class="weather-body">
                            <p class="city">Weather unavailable</p>
                            <p class="condition">Could not load forecast right now.</p>
                        </div>
                    </div>
                <% } %>
                </div>

                <!-- Budget Summary -->
                <div class="row mb-4">
                    <div class="col-md-4">
                        <div class="card shadow-sm summary-card summary-income">
                            <div class="card-body">
                                <h6 class="text-muted">Income <%= periodLabel %></h6>
                                <h4 class="mb-0">
                                    <%= formatMoney(totalIncome) %>
                                </h4>
                                <% if (isFiltered) { %>
                                    <small class="text-muted">All time: <%= formatMoney(totalIncomeAllTime) %></small>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm summary-card summary-expense">
                            <div class="card-body">
                                <h6 class="text-muted">Expense <%= periodLabel %></h6>
                                <h4 class="mb-0">
                                    <%= formatMoney(totalExpense) %>
                                </h4>
                                <% if (isFiltered) { %>
                                    <small class="text-muted">All time: <%= formatMoney(totalExpenseAllTime) %></small>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="card shadow-sm summary-card summary-balance">
                            <div class="card-body">
                                <h6 class="text-muted">Balance <%= periodLabel %></h6>
                                <h4 class="mb-0">
                                    <%= formatMoney(balance) %>
                                </h4>
                                <% if (isFiltered) { %>
                                    <small class="text-muted">All time: <%= formatMoney(balanceAllTime) %></small>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>


                <div class="mb-4">
                    <button class="btn btn-success me-2" onclick="toggleIncome()">+ Add Income</button>
                    <button class="btn btn-danger" onclick="toggleExpense()">+ Add Expense</button>
                </div>


                <div id="incomeForm" class="card shadow-sm mb-4 d-none">
                    <div class="card-body">
                        <h5>Add Income</h5>
                        <form method="POST" action="/add-income">
                            <div class="mb-3">
                                <input type="number" name="amount" class="form-control" placeholder="Enter amount"
                                    required>
                                <input type="text" name="category" class="form-control mb-2"
                                    placeholder="Category (e.g. Salary)">
                                <input type="text" name="description" class="form-control mb-2"
                                    placeholder="Description">
                            </div>
                            <button class="btn btn-success">Save Income</button>
                        </form>
                    </div>
                </div>


                <div id="expenseForm" class="card shadow-sm mb-4 d-none">
                    <div class="card-body">
                        <h5>Add Expense</h5>
                        <form method="POST" action="/add-expense">
                            <div class="mb-3">
                                <input type="number" name="amount" class="form-control" placeholder="Enter amount"
                                    required>
                                <input type="text" name="category" class="form-control mb-2"
                                    placeholder="Category (e.g. Food)">
                                <input type="text" name="description" class="form-control mb-2"
                                    placeholder="Description">
                            </div>
                            <button class="btn btn-danger">Save Expense</button>
                        </form>
                    </div>
                </div>


                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0">Transaction History</h5>
                            <form method="GET" action="/dashboard" class="d-flex gap-2">
                                <select name="month" class="form-select form-select-sm w-auto">
                                    <option value="">All Months</option>
                                    <option value="1" <%= selectedMonth == '1'? 'selected' :'' %>>January</option>
                                    <option value="2" <%= selectedMonth == '2'? 'selected' :'' %>>February</option>
                                    <option value="3" <%= selectedMonth == '3'? 'selected' :'' %>>March</option>
                                    <option value="4" <%= selectedMonth == '4'? 'selected' :'' %>>April</option>
                                    <option value="5" <%= selectedMonth == '5'? 'selected' :'' %>>May</option>
                                    <option value="6" <%= selectedMonth == '6'? 'selected' :'' %>>June</option>
                                    <option value="7" <%= selectedMonth == '7'? 'selected' :'' %>>July</option>
                                    <option value="8" <%= selectedMonth == '8'? 'selected' :'' %>>August</option>
                                    <option value="9" <%= selectedMonth == '9'? 'selected' :'' %>>September</option>
                                    <option value="10" <%= selectedMonth == '10'? 'selected' :'' %>>October</option>
                                    <option value="11" <%= selectedMonth == '11'? 'selected' :'' %>>November</option>
                                    <option value="12" <%= selectedMonth == '12'? 'selected' :'' %>>December</option>
                                </select>
                                <select name="year" class="form-select form-select-sm w-auto">
                                    <option value="" <%= selectedYear === "" ? "selected" : "" %>>All Years</option>
                                    <% for (let y = new Date().getFullYear(); y >= 2020; y--) { %>
                                        <option value="<%= y %>" <%= selectedYear === y ? "selected" : "" %>><%= y %></option>
                                    <% } %>
                                </select>
                                <button class="btn btn-primary">Filter</button>
                            </form>
                        </div>
                        <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Category</th>
                                <th>Description</th>
                                <th>Amount</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (transactions.length === 0) { %>
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-4">
                                        <% if (isFiltered) { %>
                                            No transactions for this period.
                                        <% } else { %>
                                            No transactions yet. Add your first income or expense above.
                                        <% } %>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% transactions.forEach(t => { %>
                                <tr>
                                    <td>
                                        <%= new Date(t.created_at).toLocaleDateString() %>
                                    </td>
                                    <td>
                                        <% if (t.type === 'income') { %>
                                            <span class="badge bg-success-subtle text-success">Income</span>
                                        <% }else{ %>
                                            <span class="badge bg-danger-subtle text-danger">Expense</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <%= t.category %>
                                    </td>
                                    <td>
                                        <%= t.description %>
                                    </td>
                                    <td><%= formatMoney(t.amount) %>
                                    </td>
                                    <td class="text-nowrap">
                                        <form class="table-action-form" action="/delete-transaction/<%=t.id%>" method="POST">
                                            <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                                        </form>
                                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="openEditModal(
                                            '<%= t.id %>',
                                            '<%= t.amount %>',
                                            '<%= t.category %>',
                                            '<%= t.description %>'
                                            )">
                                            Edit
                                        </button>
                                    </td>
                                </tr>
                                <% }) %>
                                <%}%>
                        </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
</div>

<div id="editModal" class="modal-overlay">

    <div class="modal-box">

        <h3>Edit Transaction</h3>

        <form id="editForm" method="POST">

            <label class="form-label">Amount</label>
            <input type="number" name="amount" id="editAmount" class="form-control mb-3" required>

            <label class="form-label">Category</label>
            <input type="text" name="category" id="editCategory" class="form-control mb-3" required>

            <label class="form-label">Description</label>
            <input type="text" name="description" id="editDescription" class="form-control mb-3">

            <button type="submit" class="btn btn-primary me-2">Update</button>
            <button type="button" class="btn btn-secondary" onclick="closeModal()">Cancel</button>

        </form>

    </div>
</div>

    <%- include('../partials/footer') %>