<section class="steps-section py-5">
  <div class="container">
    <div class="text-center mb-5">
      <h2 class="fw-bold mb-2">How it works</h2>
      <p class="text-muted mb-0">Get started in minutes with email or Google sign-in.</p>
    </div>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="step-card text-center h-100">
          <span class="step-number">1</span>
          <h5 class="mt-3 mb-2">Create your account</h5>
          <p class="text-muted mb-0">Sign up for free with email or continue with Google.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="step-card text-center h-100">
          <span class="step-number">2</span>
          <h5 class="mt-3 mb-2">Add your transactions</h5>
          <p class="text-muted mb-0">Record income and expenses as they happen.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="step-card text-center h-100">
          <span class="step-number">3</span>
          <h5 class="mt-3 mb-2">Review your dashboard</h5>
          <p class="text-muted mb-0">Check totals, charts, filters, and ask the AI for insights.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="cta-section py-5 text-center">
  <div class="container">
    <h3 class="fw-bold mb-2">Ready to take control of your budget?</h3>
