<%- include('../partials/app-header') %>

<div class="d-flex app-layout">
    <%- include('../partials/sidebar') %>

    <div class="app-content">
        <div class="container-fluid">
            <% if (flash === 'saved') { %>
                <div class="alert alert-success alert-dismissible fade show">
                    Profile updated successfully.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>
            <% if (flash === 'error') { %>
                <div class="alert alert-danger alert-dismissible fade show">
                    Could not save profile. Please try again.
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title mb-1">Profile</h3>
                    <p class="text-muted mb-4">Update your display name and weather city.</p>

                    <form method="POST" action="/profile" class="profile-form">
                        <div class="mb-3">
                            <label for="profileName" class="form-label">Display name</label>
                            <input
                                type="text"
                                name="name"
                                id="profileName"
                                class="form-control"
                                placeholder="Your name"
                                value="<%= user.name || '' %>"
                            >
                        </div>

                        <div class="mb-3">
                            <label for="profileCity" class="form-label">Weather city</label>
                            <input
                                type="text"
                                name="weather_city"
                                id="profileCity"
                                class="form-control"
                                placeholder="e.g. Karachi, London, New York"
                                value="<%= user.weather_city || 'Karachi' %>"
                                required
                            >
                            <small class="text-muted">Used for the weather widget on your dashboard.</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" value="<%= user.email %>" disabled>
                        </div>

                        <button type="submit" class="btn btn-primary">Save changes</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
