<div id="chatbot-panel">
    <div class="chatbot-header">
        <div>
            <h5>AI Assistant</h5>
            <small>Ask about your budget</small>
        </div>
        <button id="close-chat" type="button" aria-label="Close chat">×</button>
    </div>
    <div id="chat-messages">
        <div class="bot-message">
            Hi! I can help you understand your spending.
            <ul>
                <li>How much did I spend last month?</li>
                <li>Which category costs me the most?</li>
                <li>What is my balance?</li>
            </ul>
        </div>
    </div>
    <div class="chat-input">
        <input type="text" id="chat-input" placeholder="Ask something..." autocomplete="off">
        <button id="send-btn" type="button">Send</button>
    </div>
</div>
