<% const displayName = user.name || user.email.split("@")[0]; %>
<% const userEmail = user.email; %>
<% const initial = displayName.charAt(0).toUpperCase(); %>

<aside id="sidebar" class="sidebar">
  <div class="sidebar-brand">
  <span class="sidebar-brand-icon" aria-hidden="true">B</span>
    <span class="sidebar-text sidebar-brand-name">BudgetTracker</span>
  </div>

  <nav class="sidebar-nav" aria-label="Main navigation">
    <a
      href="/dashboard"
      class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>"
    >
      <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4.5a.5.5 0 0 0 .5-.5v-4h2v4a.5.5 0 0 0 .5.5H14a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293z"/>
      </svg>
      <span class="sidebar-text">Dashboard</span>
    </a>
    <a
      href="/profile"
      class="sidebar-link <%= typeof activePage !== 'undefined' && activePage === 'profile' ? 'active' : '' %>"
    >
      <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0"/>
        <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1"/>
      </svg>
      <span class="sidebar-text">Profile</span>
    </a>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-user" title="<%= userEmail %>">
      <div class="sidebar-avatar" aria-hidden="true"><%= initial %></div>
      <div class="sidebar-user-info sidebar-text">
        <span class="sidebar-user-name"><%= displayName %></span>
        <span class="sidebar-user-email"><%= userEmail %></span>
      </div>
    </div>

    <form method="GET" action="/logout" class="sidebar-logout-form">
      <button type="submit" class="sidebar-signout">
        <svg class="sidebar-icon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
          <path fill-rule="evenodd" d="M6 12.5a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-8a.5.5 0 0 0-.5.5v2a.5.5 0 0 1-1 0v-2A1.5 1.5 0 0 1 6.5 2h8A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 5 12.5v-2a.5.5 0 0 1 1 0z"/>
          <path fill-rule="evenodd" d="M.146 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L1.707 7.5H10.5a.5.5 0 0 1 0 1H1.707l2.147 2.146a.5.5 0 0 1-.708.708z"/>
        </svg>
        <span class="sidebar-text">Sign out</span>
      </button>
    </form>
  </div>
</aside>
